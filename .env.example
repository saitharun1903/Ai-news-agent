# ==============================================================================
# ResearchPulse Environment Configuration Template
# All providers are modular and can be toggled on/off.
# Secrets MUST remain server-side and never be exposed to the browser.
# ==============================================================================

# Primary Research Sources
ARXIV_ENABLED=true

SEMANTIC_SCHOLAR_ENABLED=true
SEMANTIC_SCHOLAR_API_KEY=

OPENALEX_ENABLED=true
OPENALEX_EMAIL=pulse@researchpulse.dev

CROSSREF_ENABLED=true
CROSSREF_MAILTO=pulse@researchpulse.dev

CORE_ENABLED=false
CORE_API_KEY=

# News & Community Sources
RSS_ENABLED=true
HACKER_NEWS_ENABLED=true

NEWSAPI_ENABLED=true
NEWSAPI_KEY=

GITHUB_ENABLED=true
GITHUB_TOKEN=

REDDIT_ENABLED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

X_ENABLED=false
X_API_KEY=

# AI Synthesis & Explanation Engine (Grounded only, not a fake data source)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Suppression and Retention Policies
NEW_ITEM_SUPPRESSION_DAYS=30
SNAPSHOT_RETENTION_DAYS=10

# Desktop Briefing Preferences
NEXT_PUBLIC_DEFAULT_BRIEFING_TIME="08:30"
NEXT_PUBLIC_ENABLE_DESKTOP_POPUP="true"
